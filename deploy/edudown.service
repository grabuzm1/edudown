[Unit]
Description=EduDown Pro FastAPI backend
After=network.target

[Service]
WorkingDirectory=/var/www/edudown/backend
ExecStart=/var/www/edudown/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target